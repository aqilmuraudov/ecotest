# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase database config
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudinary CDN config (Primary upload provider)
VITE_CLOUDINARY_CLOUD_NAME=sdektval
VITE_CLOUDINARY_UPLOAD_PRESET=ecolife_preset

# Cloudflare R2 Storage config (Optional - can also be configured directly in Admin Panel)
VITE_R2_ACCOUNT_ID=
VITE_R2_ACCESS_KEY_ID=
VITE_R2_SECRET_ACCESS_KEY=
VITE_R2_BUCKET_NAME=ecolife
VITE_R2_PUBLIC_DOMAIN=


# Upload provider: set to "r2" to upload to Cloudflare R2 via /api/upload (default: Cloudinary)
VITE_STORAGE_PROVIDER=
VITE_R2_PUBLIC_DOMAIN=
# Server-only (Vercel env, NOT prefixed with VITE_): R2_ACCOUNT_ID, R2_ACCESS_KEY_ID,
# R2_SECRET_ACCESS_KEY, R2_BUCKET_NAME, R2_PUBLIC_DOMAIN (e.g. cdn.ecolife.az)

# ---- AI digital seller (server-side only: set these in .env.local and in Vercel, never with a VITE_ prefix)
AI_BASE_URL=https://api.gonkarouter.io/v1
AI_API_KEY=
AI_MODEL_LIGHT=zai-org/GLM-5.3-Flash
AI_MODEL_THINK=MiniMaxAI/MiniMax-M2.7
AI_MODEL_FALLBACK=deepseek-ai/DeepSeek-V4-Flash-0731
# Optional fast provider (Groq). When set it is tried first, Gonka models stay as the fallback.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Server-only Supabase key used by /api/lead to save inquiries (then the public anon INSERT policy can be dropped)
SUPABASE_SERVICE_ROLE_KEY=
# Cloudflare Turnstile (human check on /api/chat and /api/lead). Both are optional; the check is off until the secret is set.
# VITE_TURNSTILE_SITE_KEY is public (built into the page); TURNSTILE_SECRET_KEY is server-only.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Telegram: bot token from BotFather and the sales group chat id (negative number for groups)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Sales consultant WhatsApp number, digits only, with country code
SALES_WHATSAPP=994504507007
SITE_URL=https://ecolife.az

# Room-photo analysis (any OpenAI-compatible vision model). VISION_EFFORT=minimal is faster and cheaper on reasoning models.
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=
VISION_EFFORT=
# Optional chat gateway as a second choice after Groq (CLEAN_CHAT=on) or for testing before Groq (CLEAN_CHAT=first). Reuses the VISION_* key/base unless CLEAN_* are set.
CLEAN_CHAT=
CLEAN_CHAT_MODEL=gpt-5.6-luna
CLEAN_CHAT_MODEL_2=glm-5.3
CLEAN_CHAT_EFFORT=minimal
